# Copy this file to .env and fill in values as needed. Never commit the real .env file.

# --- Storage backend ---
# "local" stores datasets on disk under LOCAL_STORAGE_DIR — no Azure account needed, use this for local dev.
# "azure" stores datasets in Azure Blob Storage — use this in production.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data

# Only needed when STORAGE_BACKEND=azure. Use ONE of the two auth options below.
# Option A: connection string (simplest, from Azure Portal > Storage Account > Access keys)
AZURE_STORAGE_CONNECTION_STRING=
# Option B: account URL + managed identity / az login (DefaultAzureCredential) — no secret stored
AZURE_STORAGE_ACCOUNT_URL=
AZURE_BLOB_CONTAINER=datasets

# --- Upload guardrails ---
MAX_UPLOAD_SIZE_MB=10

# --- Azure ML workspace: required for /api/training/* and /api/predict/* ---
# Authenticates via DefaultAzureCredential — run `az login` locally, or use a
# managed identity in Container Apps. No secret needed here.
AZURE_ML_SUBSCRIPTION_ID=
AZURE_ML_RESOURCE_GROUP=
AZURE_ML_WORKSPACE_NAME=

# --- AutoML job limits (cost + demo-snappiness guardrails) ---
TRAINING_JOB_TIMEOUT_MINUTES=15
TRAINING_TRIAL_TIMEOUT_MINUTES=5
TRAINING_MAX_TRIALS=20
TRAINING_SERVERLESS_INSTANCE_TYPE=Standard_DS3_v2

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173
