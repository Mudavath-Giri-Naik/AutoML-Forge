# Copy this file to .env and fill in values as needed. Never commit the real .env file.

# --- Storage backend ---
# "local" stores datasets on disk under LOCAL_STORAGE_DIR — no Azure account needed, use this for local dev.
# "azure" stores datasets in Azure Blob Storage — use this in production.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data

# Only needed when STORAGE_BACKEND=azure. Use ONE of the two auth options below.
# Option A: connection string (simplest, from Azure Portal > Storage Account > Access keys)
AZURE_STORAGE_CONNECTION_STRING=
# Option B: account URL + managed identity / az login (DefaultAzureCredential) — no secret stored
AZURE_STORAGE_ACCOUNT_URL=
AZURE_BLOB_CONTAINER=datasets

# --- Upload guardrails ---
MAX_UPLOAD_SIZE_MB=10

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173
